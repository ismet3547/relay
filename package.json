{
  "name": "relay",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:api": "node scripts/smoke.mjs",
    "dev:all": "node scripts/run.mjs dev",
    "start:all": "node scripts/run.mjs start",
    "transcriber": "node scripts/run.mjs worker",
    "transcriber:check": "node scripts/run.mjs check",
    "model:download": "node scripts/run.mjs download",
    "test:worker": "node scripts/run.mjs test",
    "test:video": "node scripts/video-smoke.mjs",
    "test:cashier": "node scripts/cashier-smoke.mjs"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/busboy": "1.5.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
